{
  "name": "electron-native-deps",
  "version": "0.1.0",
  "private": true,
  "description": "Native Linux dependencies for Electron 37 on systems with GLIBC <= 2.28.",
  "license": "MIT",
  "engines": {
    "node": ">=16.20.2"
  },
  "consumer": {
    "product": "DSH HAREMESS + Electron client",
    "electron": "37.2.2"
  },
  "target": {
    "os": "linux",
    "glibc_max": "2.28",
    "architectures": ["x64", "arm64", "loong64"]
  },
  "nativeDependencies": {
    "node-pty": "1.1.0-beta33",
    "sharp": "0.32.6",
    "koffi": "3.3.3",
    "@deepseek-ai/node-addon-landlock-run": "0.1.1",
    "@vscode/ripgrep": "1.18.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "toolchain": {
    "repository": "FusionSync/electron-loong64",
    "release": "toolchain-v1",
    "url": "https://github.com/FusionSync/electron-loong64/releases/tag/toolchain-v1"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "verify": "python3 scripts/verify-release.py",
    "manifest": "python3 scripts/generate-manifest.py"
  }
}
